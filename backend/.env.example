# Voz Alvinho — Backend Environment Variables
# Copy this to .env and fill in your API keys

# Required: OpenAI API key (LLM + TTS)
OPENAI_API_KEY=your_openai_api_key_here

# Required: Groq API key (STT - ultra-low latency Whisper)
GROQ_API_KEY=your_groq_api_key_here

# Optional: TTS configuration
TTS_VOICE=nova
TTS_MODEL=tts-1

# Optional: Server configuration
HOST=0.0.0.0
PORT=8000
